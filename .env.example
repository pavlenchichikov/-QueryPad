# QueryPad environment variables. Copy to .env and fill in.
# .env is gitignored - never commit real keys.

# Anthropic (Claude) - needed only for the "Claude" AI provider
ANTHROPIC_API_KEY=

# OpenAI (GPT) - needed only for the "GPT" AI provider
OPENAI_API_KEY=

# No key? QueryPad falls back to the offline Local ML model automatically.
